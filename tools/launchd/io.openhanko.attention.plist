<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional. Runs the attention agent, which lights the device's LED while macOS
  is authenticating. The device works fine without it — see README.md.

  Edit the two paths below to match this checkout, then:

    cp tools/launchd/io.openhanko.attention.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/io.openhanko.attention.plist

  To stop and remove it:

    launchctl unload ~/Library/LaunchAgents/io.openhanko.attention.plist
    rm ~/Library/LaunchAgents/io.openhanko.attention.plist

  A LaunchAgent, not a LaunchDaemon: it runs as you, in your session, and needs
  no elevated privileges. It reads the unified log and writes to the device's
  CDC console. It does not touch the PAM stack and cannot affect whether an
  authentication succeeds.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.openhanko.attention</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/CHANGEME/work/smart-card/tools/attention_agent.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- `log stream` exiting is abnormal; the agent restarts it internally, but
         KeepAlive covers the agent itself dying. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/smartcard-attention.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/smartcard-attention.log</string>
</dict>
</plist>
