<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Non-negotiable: ctkd refuses to launch an unsandboxed token extension,
	     and says so only in the pkd log ("plug-ins must be sandboxed"). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The extension talks to the device itself rather than proxying through
	     the app. Whether TCC will grant a background-launched extension this is
	     the open question; if not, the fallback is an XPC hop to the app, which
	     is what Apple's PlatformSSOToken does. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
</dict>
</plist>
